# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is loaded automatically (see app.py / scripts/ingest.py) and must
# never be committed with real values in it.

# --- data.gov.in (Open Government Data Platform India) ---------------------
# Self-service, no approval wait:
#   1. Register at https://data.gov.in
#   2. Log in -> "My Account" -> copy your API key (32-char hex string)
DATA_GOV_API_KEY=

# --- AI Kosh (aikosh.indiaai.gov.in) ---------------------------------------
# Requires registering as an API consumer on the portal. As of this
# integration pass, no public endpoint documentation could be located, so
# ingestion/aikosh.py is a documented placeholder until that documentation
# and a key are obtained. Leave blank until you have both.
AIKOSH_API_KEY=

# --- CoWIN / vaccination public API (served via apisetu.gov.in) -----------
# The historical public endpoints (cdn-api.co-vin.in) do not require a key,
# but returned HTTP 503 during this integration (see ingestion/cowin.py
# comments). Leave blank unless apisetu issues you a subscription key.
COWIN_API_KEY=
